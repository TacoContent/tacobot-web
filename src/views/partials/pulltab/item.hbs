<div class="card {{#if (not redeemed_at)}}border-warning{{else}}border-primary{{/if}} bg-primary-subtle text-bg-primary" {{#if (not redeemed_at)}}data-expired="true" data-expired-text="pending"{{/if}}>
  <div class="card-header text-muted">
    <h5 class="card-title">{{> discord/user user=this.user_id guild=this.guild_id }}</h5>
    <h6 class="card-subtitle mb-2 text-body-secondary">
      <span class="float-end">
        <span class="text-uppercase me-1 text-muted">State:</span><span class="text-uppercase me-1 text-muted">{{#if redeemed_at}}Redeemed{{else}}Pending{{/if}}</span>
      </span>
      <span class="float-start">
        <span class="text-uppercase me-1 text-muted">Purchased:</span>{{> date date=this.created_at unknown="UNKNOWN"}}
      </span>
    </h6>
  </div>

  <div class="card-body">
    <div class="row mb-2">
      <div class="col-6">
        <div class="input-group mb-1">
          <span class="input-group-text">Cost</span>
          <div class="form-control">{{this.cost}}</div>
          <span class="input-group-text">🌮</span>
        </div>
      </div>
      <div class="col-6">
        <div class="input-group mb-1">
          <span class="input-group-text">Reward</span>
          <div class="form-control">{{this.reward}}</div>
        </div>
      </div>
    </div>
    <div class="row mb-2">
      <div class="col-6">
        <div class="input-group mb-1">
          <span class="input-group-text">Purchase Multiplier</span>
          <div class="form-control">{{this.purchase_multiplier}}</div>
        </div>
      </div>
      <div class="col-6">
        <div class="input-group mb-1">
          <span class="input-group-text">Effective Multiplier</span>
          <div class="form-control">{{this.effective_multiplier}}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="card-body">
    <div class="row">
      <div class="col">
        {{> pulltab/ticket ticket=this.ticket results=this.lineResults}}
      </div>
    </div>
    
  </div>
  <div class="card-footer text-muted text-center">
    <div class="input-group mb-1">
      <span class="input-group-text">S/N</span>
      {{> code value=this.code copy=true spoiler=true class="form-control"}}
    </div>
  </div>
</div>
