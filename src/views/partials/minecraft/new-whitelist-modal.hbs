
{{!-- Modal for adding a new Minecraft whitelist entry --}}
{{!--
  guild_id: The ID of the Discord guild
  user_id: The ID of the Discord user
  minecraftUsername: The Minecraft username
  minecraftUuid: The Minecraft UUID
--}}

<div class="container-fluid">
  <div class="row g-3 align-items-start">
    <div class="col-auto">
      <img id="add-wl-preview" src="" alt="Minecraft player preview" width="120" height="270" class="border rounded bg-dark p-2" />
    </div>
    <div class="col">
      <div class="mb-3">
        <label for="add-wl-guild" class="form-label">Guild</label>
        {{> controls/GuildSelector id="add-wl-guild" name="guildId" required=true multiple=false formControl=true value=this.guild_id}}
        {{!-- <input type="text" class="form-control" id="add-wl-guild" name="guildId" placeholder="Guild ID" /> --}}
      </div>
      <div class="mb-3">
        <label for="add-wl-discord" class="form-label">Discord User</label>
        {{> controls/UserSelector id="add-wl-discord" name="user_id" required=true multiple=false formControl=true searchable=true value=this.user_id}}
        {{!-- <input type="text" class="form-control" id="add-wl-discord" name="discordUser" placeholder="@username or ID" /> --}}
      </div>
      <div class="mb-3">
        <label for="add-wl-username" class="form-label">Minecraft Username</label>
        <input type="text" class="form-control" id="add-wl-username" name="minecraftUsername" placeholder="Notch" autocomplete="off" value="{{this.minecraftUsername}}" />
        <input type="hidden" id="add-wl-uuid" name="minecraftUuid" value="{{this.minecraftUuid}}" />
      </div>
    </div>
  </div>
</div>
