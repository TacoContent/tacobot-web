<div class="card {{#unless this.enabled}}border-secondary bg-light-subtle{{/unless}} text-start">
  <div class="card-header d-flex justify-content-between align-items-center">
    <div class="text-truncate me-2">
      <h5 class="card-title mb-0 text-truncate">{{this.item_id}}</h5>
      {{#if this.metadata.name}}<small class="text-muted">{{this.metadata.name}}</small>{{/if}}
    </div>
    <div class="text-end">
      {{#if this.enabled}}<span class="badge bg-success">Enabled</span>{{else}}<span class="badge bg-secondary">Disabled</span>{{/if}}
    </div>
  </div>

  <div class="card-body">
    <div class="row">
      <div class="col">

        <p class="mb-1"><strong>Variant:</strong> <code class="text-monospace">{{#if this.variant_id}}{{this.variant_id}}{{else}}{{@key}}{{/if}}</code></p>
        <p class="mb-1"><strong>Quantity:</strong> {{#if (eq this.quantity -1)}}Unlimited{{else}}{{this.quantity}}{{/if}}</p>
        <p class="mb-1"><strong>Buy:</strong> {{#if (eq this.buy -1)}}N/A{{else if (eq this.buy 0)}}Free{{else}}{{this.buy}}{{/if}}</p>
        <p class="mb-0"><strong>Sell:</strong> {{#if (eq this.sell 0)}}N/A{{else}}{{this.sell}}{{/if}}</p>
      </div>
    </div>
    <div class="row">
      <div class="col">
        {{#if this.nbt}}
          <div class="card mb-2 text-start">
            <div class="card-body p-2 small mono">
{{> highlight value=(jsonPretty this.nbt)}}
            </div>
          </div>
        {{/if}}

        {{#if this.expires_at}}
          <div class="text-muted small">Expires: {{> date date=this.expires_at unknown="Never"}}</div>
        {{/if}}
        {{#if this.created_at}}
          <div class="text-muted small">Posted: {{> date date=this.created_at unknown="UNKNOWN"}}</div>
        {{/if}}
      </div>
    </div>
  </div>

  <div class="card-footer text-end">
    <a href="/minecraft/shop/{{shopId}}/items/{{#if this.variant_id}}{{this.variant_id}}{{else}}{{@key}}{{/if}}/edit" class="btn btn-sm btn-secondary">Edit</a>
    <form method="POST" action="/minecraft/shop/items/delete" class="d-inline-block ms-1">
      <input type="hidden" name="shop_id" value="{{shopId}}" />
      <input type="hidden" name="variant_id" value="{{#if this.variant_id}}{{this.variant_id}}{{else}}{{@key}}{{/if}}" />
      <button type="submit" class="btn btn-sm btn-danger">Delete</button>
    </form>
  </div>
</div>
