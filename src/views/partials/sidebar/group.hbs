<li class="nav-item">
  <span class="nav-link text-muted p-0">
    <a class="nav-link text-muted{{#unless active}} collapsed{{/unless}}" href="#{{id}}" data-bs-toggle="collapse" aria-expanded="{{#if active}}true{{else}}false{{/if}}" aria-controls="{{id}}">
      <strong><i class="fa fa-{{icon}} me-2" aria-hidden="true"></i> {{title}}</strong>
    </a>
  </span>
  <div class="collapse{{#if active}} show{{/if}}" id="{{id}}">
    <ul class="nav flex-column ms-3">
      {{{children}}}
    </ul>
  </div>
</li>
