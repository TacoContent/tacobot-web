{{> Dropdown id=id
    name=(or name label id)
    items=false
    placeholder=(concat "Select " (plural (or maxSelected 1) 'User' 'Users'))
    multiple=multiple
    searchable=(eq searchable true)
    closeOnSelect=true
    asyncQueryParam="q"
    asyncAllowEmptyQuery=true
    asyncEmptyQueryParam="popular"
    asyncEmptyQueryValue="true"
    asyncEmptyCacheTtlMs=60000
    asyncMinChars=0
    asyncDebounce=300
    asyncShowLoadingRow=true
    asyncPendingText="Searching..."
    asyncErrorFadeMs=2000
    asyncPreserveStatic=true
    asyncClearOnQuery=true
    noResultsText="Zero results" }}

{{#section "scripts"}}
<script>
  $(() => {
    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/[&<>"']/g, s => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[s]));
    }

    function userItemTemplate(item) {
      let iconHtml = '';
      if (item.avatar || item.default_avatar) {
          const iconUrl = item.avatar || item.default_avatar;
          iconHtml = `<img src="${iconUrl}" width="24" height="24" class="rounded me-2" alt="" data-img-error="" />`;
      } else {
          iconHtml = `<span class="me-2" style="width:24px; display:inline-block; text-align:center;"><i class="fa fa-user"></i></span>`;
      }
      const name = item.global_name || item.display_name || item.displayname || item.username || item.name || item.user_id || 'Unknown User';
      return `<div class="d-flex align-items-center">
        ${iconHtml} ${escapeHtml(name)}
      </div>`;
    }

    whenControlReady("{{id}}", wrap => {
      wrap.dropdownControl.configureAsync({
        initialFetchOnMount: true,
        initialQuery: '',
        minChars: 0,
        debounceMs: 300,
        clearOnQuery: true,
        showLoading: true,
        showLoadingRow: true,
        pendingText: 'Loading users...',
        fetcher: async (query, signal) => {
          const params = new URLSearchParams();
          if (query) params.set('q', query);
          const res = await fetch('/api/v1/users' + (params.toString() ? ('?' + params.toString()) : ''), { signal });
          if (!res.ok) throw new Error('Remote fetch failed');
          const data = await res.json();
          
          const lcQuery = query ? query.toLowerCase() : '';
          const results = data
            .filter(g => {
              if (!lcQuery) return true;
              if (!g.displayname && !g.username && !g.display_name && !g.global_name && !g.name) return false;
              if (g.displayname && g.displayname.toLowerCase().includes(lcQuery)) return true;
              if (g.display_name && g.display_name.toLowerCase().includes(lcQuery)) return true;
              if (g.name && g.name.toLowerCase().includes(lcQuery)) return true;
              if (g.username && g.username.toLowerCase().includes(lcQuery)) return true;
              if (g.global_name && g.global_name.toLowerCase().includes(lcQuery)) return true;
              if (g.user_id && g.user_id.toLowerCase().includes(lcQuery)) return true;
              
              return false;
            })
            .map(g => ({
                value: g.user_id,
                html: userItemTemplate(g)
            }));

          return results;
        }
      });
    });
  });
</script>
{{/section}}
