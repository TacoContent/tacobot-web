{{> Dropdown id=id
    name=(or name label id)
    items=false
    placeholder=(concat "Select " (plural (or maxSelected 1) 'Role' 'Roles'))
    multiple=multiple
    searchable=(eq searchable true)
    closeOnSelect=true
    asyncQueryParam="q"
    asyncAllowEmptyQuery=true
    asyncEmptyQueryParam="popular"
    asyncEmptyQueryValue="true"
    asyncEmptyCacheTtlMs=60000
    asyncMinChars=0
    asyncDebounce=300
    asyncShowLoadingRow=true
    asyncPendingText="Searching..."
    asyncErrorFadeMs=2000
    asyncPreserveStatic=true
    asyncClearOnQuery=true
    noResultsText="Zero results" }}

{{#section "scripts"}}
<script>
  $(() => {
    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/[&<>"']/g, s => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[s]));
    }

    function roleItemTemplate(item) {
      let iconHtml = '';
      if (item.icon || item.display_icon) {
          const iconUrl = item.icon || item.display_icon;
          iconHtml = `<img src="${iconUrl}" width="24" height="24" class="rounded me-2" alt="" data-img-error="" />`;
      } else if (item.unicode_emoji) {
          iconHtml = `<span class="me-2" style="width:24px; display:inline-block; text-align:center;">${escapeHtml(item.unicode_emoji)}</span>`;
      } else {
          iconHtml = `<span class="me-2" style="width:24px; display:inline-block; text-align:center;"><i class="fa fa-users"></i></span>`;
      }
      const name = item.name || item.user_id || 'Unknown Role';
      item_color = null;
      if (item.color) {
        item_color = ` style="color:#${item.color.toString(16).padStart(6, '0')};"`;
      }
      return `<div class="d-flex align-items-center">
        ${iconHtml} <span${item_color}>${escapeHtml(name)}</span>
      </div>`;
    }

    whenControlReady("{{id}}", wrap => {
      
      wrap.dropdownControl.configureAsync({
        initialFetchOnMount: true,
        initialQuery: '',
        minChars: 0,
        debounceMs: 300,
        clearOnQuery: true,
        showLoading: true,
        showLoadingRow: true,
        pendingText: 'Loading roles...',
        fetcher: async (query, signal) => {
          // get guild_id from input/select or from another dropdown's data-selected
          // Strategy (in order):
          // 1) Look within the same form for select/input with name or id 'guild_id'
          // 2) Search the document for select/input with name or id 'guild_id'
          // 3) Fallback: find any element with '[data-selected]' whose id or name contains 'guild' and parse the first selection

          function findGuildId() {
            // Prefer elements within the same form as the control, if present
            const form = wrap.closest ? wrap.closest('form') : null;
            const withinDoc = form || document;
            let el = withinDoc.querySelector('select[name="guild_id"], input[name="guild_id"], select#guild_id, input#guild_id, #fallback_guild_id');
            if (!el) {
              el = document.querySelector('select[name="guild_id"], input[name="guild_id"], select#guild_id, input#guild_id, #fallback_guild_id');
            }
            if (el && el.value) return el.value;

            // Try to locate a dropdown root that likely represents the guild selector
            const selEl = document.querySelector('[data-selected][id*="guild"], [data-selected][name*="guild"], [data-selected][data-dropdown*="guild"]');
            if (selEl) {
              const ds = selEl.getAttribute('data-selected') || selEl.dataset.selected;
              if (ds) {
                try {
                  const parsed = JSON.parse(ds);
                  if (Array.isArray(parsed) && parsed.length) return parsed[0];
                } catch (e) {
                  // Not JSON – treat as comma-separated list
                  const parts = String(ds).split(',').map(s => s.trim()).filter(Boolean);
                  if (parts.length) return parts[0];
                }
              }
            }

            return null;
          }

          const guildId = findGuildId();
          if (!guildId) {
            console.error('No guild_id found, cannot fetch roles');
            return [];
          }

          if (guildId === '0') return [];

          const params = new URLSearchParams();
          if (query) params.set('q', query);
          const pString = params.toString() ? ('?' + params.toString()) : '';
          const res = await fetch(`/api/v1/roles/${guildId}${pString}`, { signal });
          if (!res.ok) throw new Error('Remote fetch failed');
          const data = await res.json();
          
          const lcQuery = query ? query.toLowerCase() : '';
          const results = data
            .filter(g => {
              if (!lcQuery) return true;
              if (!g.name) return false;
              if (g.name && g.name.toLowerCase().includes(lcQuery)) return true;
              if (g.id && g.id.toLowerCase().includes(lcQuery)) return true;
              
              return false;
            })
            .map(g => ({
                value: g.id,
                html: roleItemTemplate(g)
            }));

          return results;
        }
      });
    });
  });
</script>
{{/section}}
