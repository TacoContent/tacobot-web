<!-- User Permissions List Page -->
<div class="container-x mt-4">
  <div class="justify-content-center">
    <div class="row mb-3">
      <div class="col"></div>
      <div class="col">
        {{#> search id="search" name="search" placeholder="Search by User Name, ID, Display Name, or Reward" }}
        <div class="row ">
          <div class="col d-flex justify-content-left">
            <div class="form-check form-switch ms-3 justify-content-left">
              <input type="hidden" name="includeLosingTickets" value="false">
              <input class="form-check-input" value="true" name="includeLosingTickets" type="checkbox" id="includeLosingTickets" {{#if includeLosingTickets}}checked{{/if}} onchange="document.getElementById('search-form').submit();">
              <label class="form-check-label text-" for="includeLosingTickets">No Reward</label>
            </div>
          </div>
          <div class="col d-flex justify-content-center">
            <div class="form-check form-switch ms-3 justify-content-left">
              <input type="hidden" name="includePendingTickets" value="false">
              <input class="form-check-input" value="true" name="includePendingTickets" type="checkbox" id="includePendingTickets" {{#if includePendingTickets}}checked{{/if}} onchange="document.getElementById('search-form').submit();">
              <label class="form-check-label text-nowrap" for="includePendingTickets">Pending</label>
            </div>
          </div>
          <div class="col d-flex justify-content-end">
            <div class="form-check form-switch ms-3 justify-content-left">
              <input type="hidden" name="includeRedeemedTickets" value="false">
              <input class="form-check-input" value="true" name="includeRedeemedTickets" type="checkbox" id="includeRedeemedTickets" {{#if includeRedeemedTickets}}checked{{/if}} onchange="document.getElementById('search-form').submit();">
              <label class="form-check-label text-nowrap" for="includeRedeemedTickets">Redeemed</label>
            </div>
          </div>
        </div>
        {{/search}}
      </div>
      <div class="col"></div>
    </div>
    <div class="row mb-3">
      <div class="col d-flex justify-content-center">
        {{> pager this.pager search=this.search }}
      </div>
    </div>
  </div>

  <div class="row">
  {{#each items}}
    <div class="col-md-4 mb-4">
      {{> pulltab/item item=this}}
    </div>
  {{/each}}
  </div>
  
  <div class="d-flex justify-content-center">
  {{> pager this.pager}}
  </div>
</div>

{{#section 'head'}}

<link rel="stylesheet" href="/css/pulltab.css">
{{/section}}