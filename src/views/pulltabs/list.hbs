<!-- User Permissions List Page -->
<div class="container-x mt-4">
  <div class="justify-content-center">
    <div class="row mb-3">
      <div class="col"></div>
      <div class="col">
        {{#> search id="search" name="search" placeholder="Search by User Name, ID, Display Name, or Reward" }}
        <div class="row ">
          <div class="col d-flex justify-content-start">
            <div class="form-check form-switch justify-content-start">
              <input class="form-check-input" value="true" name="includeLosingTickets" type="checkbox" id="includeLosingTickets" {{#if includeLosingTickets}}checked{{/if}} onchange="this.form.requestSubmit();">
              <label class="form-check-label text-" for="includeLosingTickets">No Reward</label>
            </div>
          </div>
          <div class="col d-flex justify-content-center">
            <div class="form-check form-switch ms-3 justify-content-center">
              <input class="form-check-input" value="true" name="includePendingTickets" type="checkbox" id="includePendingTickets" {{#if includePendingTickets}}checked{{/if}} onchange="this.form.requestSubmit();">
              <label class="form-check-label text-nowrap" for="includePendingTickets">Pending</label>
            </div>
          </div>
          <div class="col d-flex justify-content-end">
            <div class="form-check form-switch ms-3 justify-content-end">
              <input class="form-check-input" value="true" name="includeRedeemedTickets" type="checkbox" id="includeRedeemedTickets" {{#if includeRedeemedTickets}}checked{{/if}} onchange="this.form.requestSubmit();">
              <label class="form-check-label text-nowrap" for="includeRedeemedTickets">Redeemed</label>
            </div>
          </div>
        </div>
        {{/search}}
      </div>
      <div class="col"></div>
    </div>
    <div class="row mb-3">
      <div class="col d-flex justify-content-center">
        {{> pager this.pager search=this.search }}
      </div>
    </div>
  </div>

  <div class="row">
  {{#each items}}
    <div class="col-md-4 mb-4">
      {{> pulltab/item item=this}}
    </div>
  {{/each}}
  </div>
  
  <div class="d-flex justify-content-center">
  {{> pager this.pager}}
  </div>

  {{> modal id="redeem-modal" title="Redeem Ticket" body="Are you sure you want to redeem this ticket?" buttonText="Redeem" buttonClass="btn-primary" }}

{{#section 'scripts'}}
<script src="/javascript/pulltabs.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('search-form');
    if (form) {
      form.addEventListener('submit', () => {
        const includeRedeemed = document.getElementById('includeRedeemedTickets');
        if (includeRedeemed) {
          if (includeRedeemed.checked) {
            // Default is true, so don't send parameter
            includeRedeemed.disabled = true;
          } else {
            // Non-default (false), send false
            // Checkbox is unchecked, so it won't send. Add hidden input.
            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'includeRedeemedTickets';
            hidden.value = 'false';
            form.appendChild(hidden);
          }
        }
      });
    }
  });
</script>
{{/section}}
</div>

{{#section 'head'}}

<link rel="stylesheet" href="/css/pulltab.css">
{{/section}}