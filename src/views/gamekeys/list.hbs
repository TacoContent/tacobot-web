<!-- Game Keys List Page -->
<div class="container-x mt-4">

  <div class="justify-content-center text-center mb-4">
    <div class="row">
    {{#each offers}}
      <div class="col-md-6">
        {{> gamekeys/offer this}}
      </div>
    {{/each}}
    </div>
  </div>

  <div class="justify-content-center">
    <div class="row mb-3">
      <div class="col"></div>
      <div class="col">
        {{#> search id="search" name="search" placeholder="Search by Title, Key, User Id" }}
        <div class="row ">
          <div class="col d-flex justify-content-start">
            <div class="form-check form-switch justify-content-start">
              <input class="form-check-input" value="true" name="includeRedeemed" type="checkbox" id="includeRedeemed" {{#if includeRedeemed}}checked{{/if}} onchange="this.form.requestSubmit();">
              <label class="form-check-label text-nowrap" for="includeRedeemed">Redeemed</label>
            </div>
          </div>
          <div class="col d-flex justify-content-end">
            <div class="form-check form-switch ms-3 justify-content-end">
              <input class="form-check-input" value="true" name="includeAvailable" type="checkbox" id="includeAvailable" {{#if includeAvailable}}checked{{/if}} onchange="this.form.requestSubmit();">
              <label class="form-check-label text-nowrap" for="includeAvailable">Available</label>
            </div>
          </div>
        </div>
        {{/search}}
        {{#section 'scripts'}}
        <script>
          document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('search-form');
            if (!form) return;

            form.addEventListener('submit', () => {
              elements = [
                'includeRedeemed',
                'includeAvailable'
              ];
              for (const id of elements) {
                const element = document.getElementById(id);
                if (!element) continue;

                if (element.checked) {
                  // default is true; don't send default -> disable the checkbox so it won't be included
                  element.disabled = true;
                } else {
                  // non-default (false) should be sent; add a hidden input with value 'false'
                  const hidden = document.createElement('input');
                  hidden.type = 'hidden';
                  hidden.name = element.name;
                  hidden.value = 'false';
                  form.appendChild(hidden);
                }
              }
            });
          });
        </script>
        {{/section}}
      </div>
      <div class="col"></div>
    </div>
    <div class="row mb-3">
      <div class="col d-flex justify-content-center">
        {{> pager this.pager search=this.search }}
      </div>
    </div>
  </div>

  <div class="row">
    {{#each items}}
      <div class="col-md-6 mb-4">
        {{> gamekeys/item}}
      </div>
    {{/each}}
  </div>

  <div class="d-flex justify-content-center">
  {{> pager this.pager}}
  </div>
</div>