<!-- Minecraft Shop Items View -->
<div class="container mt-4 text-start">

  <div class="justify-content-center">
    <div class="row mb-3">
      <div class="col"></div>
      <div class="col">
        {{#> search id="search" name="search" placeholder="Search by Item ID or Item Name" }}
          {{!-- <div class="row mt-2">
            <div class="col-6 d-flex justify-content-start">
              <div class="justify-content-start">
                {{> controls/MinecraftModSelector id="modFilter" name="modFilter" placeholder="Select a Mod to filter items" formControl=false}}
              </div>
            </div>
          
        </div> --}}
        {{/search}}
        {{#section 'scripts'}}
        <script>
          document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('search-form');
            if (!form) return;

            form.addEventListener('submit', () => {
              elements = [
                'modFilter',
              ];
              for (const id of elements) {
                const element = document.getElementById(id);
                if (!element) continue;
              }
            });
          });
        </script>
        {{/section}}
      </div>
      <div class="col"></div>
    </div>
    <div class="row mb-3">
      <div class="col d-flex justify-content-center">
        {{> pager this.pager search=this.search }}
      </div>
    </div>
  </div>

  <div class="row">
    {{#if items}}
      {{#each items}}
        <div class="col-md-4 mb-4">
          {{!-- Pass shopId explicitly so partial can render links reliably --}}
          {{> minecraft/items/item item=this}}
        </div>
      {{/each}}
    {{else}}
      <div class="col-12">
        <div class="alert alert-info">No items have been added yet.</div>
      </div>
    {{/if}}
  </div>

  <div class="d-flex justify-content-center">
  {{> pager this.pager}}
  </div>
</div>
