<!-- Minecraft Shop Items View -->
<div class="container mt-4 text-start">
  <div class="d-flex justify-content-between align-items-center mb-3 ">
    <div class="text-start">
      <h2 class="mb-0">{{#if shop.name}}{{shop.name}}{{else}}Shop{{/if}} <small class="text-muted small">{{shop.shop_id}}</small></h2>
      {{#if shop.guild_id}}<div class="text-muted small">{{> discord/guild id=shop.guild_id}}</div>{{/if}}
    </div>
    <div class="d-flex gap-2">
      <a href="/minecraft/shop/{{shop.shop_id}}/item/new" class="btn btn-primary">Add Item</a>
      <a href="/minecraft/shop/{{shop.shop_id}}/edit" class="btn btn-secondary">Edit Shop</a>
    </div>
  </div>

  <div class="justify-content-center">
    <div class="row mb-3">
      <div class="col"></div>
      <div class="col">
        {{#> search id="search" name="search" placeholder="Search by Item ID or Item Name" }}
        {{!--<div class="row ">
          <div class="col d-flex justify-content-start">
            <div class="form-check form-switch justify-content-start">
              <input class="form-check-input" value="true" name="includeExpired" type="checkbox" id="includeExpired" {{#if includeExpired}}checked{{/if}} onchange="this.form.requestSubmit();">
              <label class="form-check-label text-nowrap" for="includeExpired">Expired</label>
            </div>
          </div>
          <div class="col d-flex justify-content-end">
            <div class="form-check form-switch ms-3 justify-content-end">
              <input class="form-check-input" value="true" name="includeDisabled" type="checkbox" id="includeDisabled" {{#if includeDisabled}}checked{{/if}} onchange="this.form.requestSubmit();">
              <label class="form-check-label text-nowrap" for="includeDisabled">Disabled</label>
            </div>
          </div>
        </div>--}}
        {{/search}}
        {{!-- #section 'scripts'}}
        <script>
          document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('search-form');
            if (!form) return;

            form.addEventListener('submit', () => {
              elements = [
                'includeExpired',
                'includeDisabled'
              ];
              for (const id of elements) {
                const element = document.getElementById(id);
                if (!element) continue;

                if (element.checked) {
                  // default is true; don't send default -> disable the checkbox so it won't be included
                  element.disabled = true;
                } else {
                  // non-default (false) should be sent; add a hidden input with value 'false'
                  const hidden = document.createElement('input');
                  hidden.type = 'hidden';
                  hidden.name = element.name;
                  hidden.value = 'false';
                  form.appendChild(hidden);
                }
              }
            });
          });
        </script>
        {{/section--}}
      </div>
      <div class="col"></div>
    </div>
    <div class="row mb-3">
      <div class="col d-flex justify-content-center">
        {{> pager this.pager search=this.search }}
      </div>
    </div>
  </div>

  <div class="row">
    {{#if items}}
      {{#each items}}
        <div class="col-md-6 mb-4">
          {{!-- Pass shopId explicitly so partial can render links reliably --}}
          {{> minecraft/shop/item/item shopId=@root.shopId}}
        </div>
      {{/each}}
    {{else}}
      <div class="col-12">
        <div class="alert alert-info">No items have been added to this shop yet.</div>
      </div>
    {{/if}}
  </div>

  <div class="d-flex justify-content-center">
  {{> pager this.pager}}
  </div>

  <a href="/minecraft/shop/{{shopId}}/item/new" class="btn btn-primary rounded-circle shadow position-fixed btn-fab" aria-label="Add Item" title="Add Item">
    <i class="fas fa-plus" aria-hidden="true"></i>
  </a>
</div>

{{#section "scripts"}}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/json.min.js"></script>
  <script>$(() => { console.log("highlighting"); hljs.highlightAll(); });</script>
{{/section}}

{{#section "head"}}
  {{!-- https://highlightjs.org/demo --}}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/panda-syntax-dark.min.css" />
  {{!-- <link rel="stylesheet" href="/css/controls/json-editor.css" /> --}}
{{/section}}
