<!-- Minecraft Shop Item Edit/Add View - Bootstrap Form -->
<div class="container mt-4 text-start">
  <form method="POST" action="/minecraft/shop/item/save" id="minecraft-shop-item-form">

    {{#if item}}
      <input type="hidden" name="variant_id" value="{{item.variant_id}}" />
    {{/if}}


    <div class="mb-3">
      <div class="input-group">
        <label class="input-group-text" for="shop_id">Shop ID</label>
        <label class="input-group-text" title="Shop ID" for="shop_id"><i class="fa fa-store" aria-hidden="true"></i></label>
        <input type="text" class="form-control" id="shop_id" name="shop_id" required placeholder="shop-id" value="{{shopId}}" readonly />
      </div>
      <div class="form-text">The shop this item will belong to.</div>
    </div>

    <div class="mb-3 row">
      <div class="col-md-6">
        <div class="input-group">
          <label for="item_id" class="input-group-text">Item ID</label>
          {{#if item}}
          <label class="input-group-text p-1 m-0" title="Item ID" for="item_id">{{> minecraft/shop/item/icon item_id=item.item_id size=32}}</label>
          <input type="hidden" name="item_id" value="{{item.item_id}}" />
          <input type="text" class="form-control" id="item_id" name="" required placeholder="minecraft:item_id" value="{{item.item_id}}" disabled readonly />
          {{else}}
          <label class="input-group-text" title="Item ID" for="item_id"><i class="fa fa-cube" aria-hidden="true"></i></label>
          <input type="text" class="form-control" id="item_id" name="item_id" required placeholder="minecraft:item_id" value="{{item.item_id}}" />
          {{/if}}
        </div>
        <div class="form-text small">Minecraft item identifier (e.g. <code>minecraft:diamond</code>).</div>
      </div>

      <div class="col-md-6">
        <div class="input-group">
          <label for="item_name" class="input-group-text">Friendly Item Name</label>
          {{#if (and item item.name)}}
          <label class="input-group-text p-1 m-0" title="Friendly Item Name" for="item_name">{{> minecraft/shop/item/icon item_id=item.item_id size=32}}</label>
          <input type="text" class="form-control" id="item_name" name="name" required placeholder="Friendly Item Name" value="{{item.name}}" />
          {{else}}
          <label class="input-group-text" title="Friendly Item Name" for="item_name"><i class="fa fa-cube" aria-hidden="true"></i></label>
          <input type="text" class="form-control" id="item_name" name="name" required placeholder="Friendly Item Name" value="{{item.name}}" />
          {{/if}}
        </div>
        <div class="form-text small">Minecraft item name (e.g. <code>Diamond</code>).</div>
      </div>
    </div>

    
    <div class="mb-3 row">
      <div class="col-md-6">
      <div class="input-group">
        <div class="input-group-text">
          <input class="form-check-input" type="checkbox" id="enabled" name="enabled" value="true" {{#if item}}{{#if item.enabled}}checked{{/if}}{{else}}checked{{/if}} />
        </div>
        <label class="form-control text-start" for="enabled">Enabled</label>
      </div>
      <div class="form-text">If checked, the item is available for purchase/sale.</div>
      </div>
      <div class="col-md-6">
        <div class="input-group">
          <label class="input-group-text" for="expires_at" id="expires_at-label" >Expires At</label>
          <input type="datetime-local" class="form-control" placeholder="Expires At" aria-label="Expires At" aria-describedby="expires_at-label" {{#if item}}value="{{#if (and item.expires_at (isValidDate item.expires_at))}}{{unixToDate item.expires_at 'YYYY-MM-DDTHH:mm'}}{{/if}}"{{/if}} name="expires_at" id="expires_at" />
          <label class="input-group-text" for="field-expires_at" id="field-expires_at-emoji">
            <i class="fas fa-calendar" aria-hidden="true"></i>
          </label>
        </div>
        <div class="form-text">Optional expiration date/time for the item.</div>
      </div>
    </div>

    <div class="row mb-3">
      <div class="col-md-4">
        <div class="input-group">
          <label class="input-group-text" for="quantity">Quantity</label>
          <label class="input-group-text" for="quantity" title="Quantity"><i class="fa fa-layer-group" aria-hidden="true"></i></label>
            <input type="number" class="form-control" id="quantity" name="quantity" value="{{#if item}}{{item.quantity}}{{else}}-1{{/if}}" step="1" placeholder="Quantity" />
        </div>
        <div class="form-text">Number available. Use <code>-1</code> for unlimited (default).</div>
      </div>

      <div class="col-md-4">
        <div class="input-group">
          <label class="input-group-text" for="buy">Buy Price</label>
          <label class="input-group-text" for="buy" title="Buy Price"><i class="fa fa-shopping-cart" aria-hidden="true"></i></label>
          <input type="number" class="form-control" id="buy" name="buy" value="{{#if item}}{{item.buy}}{{else}}0{{/if}}" step="1" placeholder="Buy Price" />
          <label class="input-group-text" for="buy" title="Tacos">🌮</label>
        </div>
        <div class="form-text">Price to purchase from the shop. <code>0</code> = free, <code>-1</code> = unsellable.</div>
      </div>

      <div class="col-md-4">
        <div class="input-group">
          <label class="input-group-text" for="sell">Sell Price</label>
          <label class="input-group-text" for="sell" title="Sell Price"><i class="fa fa-coins" aria-hidden="true"></i></label>
          <input type="number" class="form-control" id="sell" name="sell" value="{{#if item}}{{item.sell}}{{else}}0{{/if}}" step="1" placeholder="Sell Price" />
          <label class="input-group-text" for="sell" title="Tacos">🌮</label>
        </div>
        <div class="form-text">Price the shop will pay. <code>0</code> = unsellable.</div>
      </div>
    </div>


    <div class="mb-3">
      <div class="input-group">
        <label class="input-group-text">NBT (JSON)</label>
        <label class="input-group-text" title="NBT" for="nbt"><i class="fa fa-code" aria-hidden="true"></i></label>
        <div class="flex-grow-1">
          <textarea class="form-control" id="nbt" name="nbt" placeholder="NBT" style="height: 160px; min-height: 120px;">{{#if item}}{{jsonPretty item.nbt}}{{/if}}</textarea>
        </div>
      </div>
      <div class="form-text">Enter NBT data as JSON (multiline). This will be parsed on submit.</div>
    </div>

    <div class="mb-3 gap-2">
      <div class="float-start">
        <button type="button" id="validate-nbt" class="btn btn-secondary me-2">Validate NBT<i class="fas fa-check ms-2"></i></button>
        <button type="button" id="prettify-nbt" class="btn btn-secondary">Prettify NBT<i class="fas fa-align-left ms-2"></i></button>
      </div>
      <div class="float-end">
        <button type="submit" class="me-2 btn btn-primary">{{#if item}}Save Item{{else}}Add Item{{/if}}<i class="fas fa-save ms-2"></i></button>
        <a href="/minecraft/shop/{{shopId}}/items" class="btn btn-secondary me-2">Cancel<i class="ms-2 fas fa-times"></i></a>
        {{#if item}}
        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#delete-shop-item-{{item.variant_id}}">Delete<i class="ms-2 fas fa-trash"></i></button>
        {{/if}}
      </div>
      <div class="clearfix"></div>
    </div>

  </form>

  {{#if item}}
    {{!-- Confirmation modal using generic modal partial --}}
    {{#> modal 
        id=(concat 'delete-shop-item-' item.variant_id) 
        title='Remove From Shop' 
        buttonText='Delete' 
        buttonClass='btn-danger' 
        cancelText='Keep' 
        formAction=(concat '/minecraft/shop/' shopId '/item/' item.variant_id '/delete') 
        formMethod='POST'}}
      <div class="mb-2">Are you sure you want to remove <code>{{or (and item.metadata item.metadata.name) item.item_id}}</code> from the shop?</div>
      <p class="text-warning small mb-0">This action cannot be undone.</p>
      <input type="hidden" name="_method" value="DELETE" />
    {{/modal}}
  {{/if}}
  <script src="/javascript/minecraft-shop-edit.js"></script>
</div>
